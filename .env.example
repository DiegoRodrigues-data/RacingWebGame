# Copie para apps/api/.env (a API lê esse arquivo ao subir). Tudo aqui é opcional em desenvolvimento.
# Nunca versione o .env de verdade: ele está no .gitignore.

# ---------- API (apps/api) ----------
# Sem DATABASE_URL, a API usa PGlite (Postgres em WASM) em PGLITE_DIR. Sem REDIS_URL, usa memória.
# DATABASE_URL=postgres://tracado:tracado@localhost:5432/tracado
# REDIS_URL=redis://localhost:6379
PGLITE_DIR=.data/pglite
PORT=3001
# Em produção, use um valor longo e aleatório (ex.: openssl rand -base64 48). O padrão de dev é recusado em produção.
JWT_SECRET=dev-secret-change-me-please-0123456789
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Admin principal (Master): e-mail e senha são reaplicados a cada boot. A senha padrão é recusada em produção.
ADMIN_EMAIL=admin@tracado.local
ADMIN_PASSWORD=admin12345
# Outras contas com acesso de admin, separadas por vírgula.
# ADMIN_EMAILS=

# Desenvolvimento: dados de demonstração, pilotos-bot e rotas para adiantar o relógio do servidor.
SEED_DEMO=true
DEMO_BOTS=14
ENABLE_DEV_ROUTES=true

# Grade automática e corridas teste (valem até o admin salvar em Admin → Configurações).
AUTO_RACES_PER_DAY=24
AUTO_TEST_RACES_GAP_MIN=2

REQUIRE_VERIFIED_EMAIL_FOR_RANKED=false
RANKING_MIN_RACES=1
LOG_LEVEL=info

# Login com Google (opcional). Sem os dois, o botão não aparece.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Observabilidade (opcional).
# METRICS_TOKEN=
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Web (apps/web, lido pelo Vite em apps/web/.env) ----------
# VITE_CONTACT_EMAIL=contato@seudominio.com

# ---------- Produção (docker-compose.prod.yml) ----------
# POSTGRES_PASSWORD=
# PUBLIC_WEB_URL=https://jogo.seudominio.com
# CONTACT_EMAIL=contato@seudominio.com
